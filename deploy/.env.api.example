# Copy to /opt/litespark/.env.api on the VPS (API runtime config)
# NOTE: NODE_ENV=production forbids OTP_MODE=dev. Until a real SMS provider is wired in,
# keep NODE_ENV=staging + OTP_MODE=dev for testing.
NODE_ENV=staging
OTP_MODE=dev

# Generate: openssl rand -hex 32   (>= 32 chars)
JWT_SECRET=change-me-to-a-64-char-random-hex-string-0000000000000000000000

# No migrations exist yet -> let TypeORM create tables. Set false once you add migrations.
DB_SYNCHRONIZE=true
DB_MIGRATIONS_RUN=false
# Seeds cities / vehicle categories / fares once (skipped if data already exists)
SEED_DEV_DATA=true

GEO_PROVIDER=nominatim
ROUTING_PROVIDER=osrm
OSRM_URL=https://router.project-osrm.org
DISPATCH_RADIUS_KM=5
THROTTLE_LIMIT=120

# Must list every browser origin that calls the API
CORS_ORIGINS=https://litetaxi.in,https://www.litetaxi.in

# Razorpay (Dashboard -> Settings -> API Keys). Use rzp_test_ keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

