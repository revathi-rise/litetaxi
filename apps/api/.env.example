# Copy to .env — contains NO real secrets.
NODE_ENV=development
PORT=3001

# memory = in-process pg-mem (dev/test only) | postgres = real PostgreSQL
DB_MODE=memory
# DATABASE_URL=postgres://user:password@localhost:5432/swiftcab
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false
SEED_DEV_DATA=true

# Required (>=32 random chars) when NODE_ENV=production
JWT_SECRET=

# dev = OTP returned in API response, no SMS sent (blocked in production) | sms = real provider
OTP_MODE=dev

# mock | nominatim
GEO_PROVIDER=mock
# mock | osrm
ROUTING_PROVIDER=mock
# OSRM_URL=https://router.project-osrm.org

DISPATCH_RADIUS_KM=5
THROTTLE_LIMIT=120
CORS_ORIGINS=
