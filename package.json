{
  "name": "swiftcab",
  "private": true,
  "version": "0.1.0",
  "description": "LiteSpark Taxi - platform monorepo (API, admin, customer app, driver app)",
  "workspaces": [
    "apps/api",
    "apps/admin"
  ],
  "scripts": {
    "api:dev": "npm run start:dev -w apps/api",
    "api:test": "npm test -w apps/api",
    "api:build": "npm run build -w apps/api",
    "admin:dev": "npm run dev -w apps/admin",
    "customer:flutter:run": "cd apps/customer_flutter && flutter run",
    "customer:flutter:web": "cd apps/customer_flutter && flutter run -d chrome --web-port 8081",
    "customer:flutter:android": "cd apps/customer_flutter && flutter run -d android",
    "driver:flutter:web": "cd apps/driver_flutter && flutter run -d chrome --web-port 8082",
    "driver:flutter:android": "cd apps/driver_flutter && flutter run -d android"
  }
}
